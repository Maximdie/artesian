# Telegram-бот для получения заявок с формы
# 1. Создайте бота: Telegram → @BotFather → /newbot
# 2. Скопируйте токен:
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOP

# 3. Узнайте chat_id: напишите боту, затем откройте
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates
#    и найдите "chat":{"id": ...}
TELEGRAM_CHAT_ID=123456789
